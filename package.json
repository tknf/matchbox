{
	"name": "@tknf/matchbox",
	"version": "1.0.0",
	"description": "A Simple Web Server Framework",
	"keywords": [
		"cgi",
		"framework",
		"hono",
		"server",
		"web"
	],
	"license": "MIT",
	"author": "tknf <dev@tknf.net>",
	"repository": {
		"url": "https://github.com/tknf/matchbox.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		},
		"./plugin": {
			"import": {
				"types": "./dist/plugin.d.ts",
				"import": "./dist/plugin.js"
			}
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"check": "vp check",
		"check:fix": "vp check --fix",
		"test": "vp test run",
		"test:coverage": "vp test run --coverage",
		"lint:check": "vp lint",
		"lint:fix": "vp lint --fix",
		"format:check": "vp fmt --check",
		"format:write": "vp fmt",
		"typecheck": "vp check --no-fmt --no-lint",
		"watch": "vp pack --watch",
		"build": "vp pack",
		"staged": "vp staged",
		"prepare": "vp config --no-agent --no-editor"
	},
	"devDependencies": {
		"@types/node": "^25.9.5",
		"@vitest/coverage-v8": "catalog:",
		"glob": "^13.0.6",
		"hono": "^4.12.28",
		"typescript": "^5.9.3",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"hono": "*",
		"vite": "^8.0.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.11.0",
			"onFail": "download"
		}
	}
}
